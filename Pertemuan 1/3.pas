program MenarikUangATM;
begin
    writeln('=============================================================');
    writeln('||              Algoritma Menarik Uang Di ATM              ||');
    writeln('=============================================================');
    writeln;
    writeln('Langkah 1: Datang ke mesin ATM');
    writeln('Langkah 2: Masukkan kartu ATM kedalam slot kartu');
    writeln('Langkah 3: Pilih bahasa yang digunakan');
    writeln('Langkah 4: Masukkan PIN ATM anda');
    writeln('Langkah 5: Pilih menu "Tarik Tunai"');
    writeln('Langkah 6: Masukkan nominal uang yang ingin ditarik');
    writeln('Langkah 7: Konfirmasi jumlah nominal dilayar');
    writeln('Langkah 8: Tunggu mesin ATM mengeluarkan uangnya');
    writeln('Langkah 9: Ambil uang tunai jika sudah dikeluarkan mesin');
    writeln('Langkah 10: Pilih opsi "Tidak" jika tidak ada transaksi lain');
    writeln('Langkah 11: Ambil kartu ATM dari mesin ATM')
end.